generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ClienteMonitorado {
  id            String   @id @default(cuid())
  organizacaoId String?  // Issue #79: Isolamento Multi-Tenant
  nome          String
  variacoes     String?  // Variações de razão social separadas por vírgula
  cnpjs         String?  // CNPJs separados por vírgula
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  @@index([organizacaoId])
}

model AdvogadoEscritorio {
  id                 String   @id @default(cuid())
  organizacaoId      String?  // Issue #79: Isolamento Multi-Tenant
  nome               String
  numeroOab          String
  ufOab              String
  ativo              Boolean  @default(true)
  emFeriasAte        String?  // Issue #47: Data ISO/BR limite de férias
  advogadoSubstituto String?  // Issue #47: Nome/OAB do substituto durante férias
  criadoEm           DateTime @default(now())
  atualizadoEm       DateTime @updatedAt

  @@unique([numeroOab, ufOab])
  @@index([organizacaoId])
}

model Processo {
  id                    String    @id @default(cuid())
  organizacaoId         String?   // Issue #79: Isolamento Multi-Tenant
  numeroProcesso        String    @unique // 20 dígitos sem máscara
  numeroFormatado       String
  siglaTribunal         String
  orgaoJulgador         String
  classeProcessual      String
  statusConcorrencia    String    // NOSSO_ESCRITORIO | ESCRITORIO_CONCORRENTE | SEM_ADVOGADO_CADASTRADO
  ultimoStatusDetectado String
  faseProcessual        String    @default("ANDAMENTO")
  prazoFatal            String?
  urgenciaMaxima        String    // ALTA | MEDIA | NORMAL
  ultimaAtualizacao     String
  partesJson            String?   // JSON serializado das partes
  advogadosJson         String?   // JSON serializado dos advogados identificados
  dataAjuizamento       String?   // Enriquecido via Datajud
  assuntosJson          String?   // Enriquecido via Datajud
  ignoradoHomonimo      Boolean   @default(false) // Issue #44: Desambiguação persistida
  prazoBaixado          Boolean   @default(false) // Issue #42: Baixa de prazo persistida
  prazoBaixadoEm        DateTime?
  minutaPronta          Boolean   @default(false) // Issue #38: Controle D-2 Controladoria
  checklistPericiaJson  String?   // Issue #64: Estado do checklist de perícia
  ultimoAlertaEnviadoEm DateTime? // Evita duplicidade de webhooks no worker
  criadoEm              DateTime  @default(now())
  atualizadoEm          DateTime  @updatedAt

  publicacoes Publicacao[]
  documentos  DocumentoOriginal[]

  @@index([organizacaoId])
}

model Publicacao {
  id                   String   @id @default(cuid())
  cnjId                Int      @unique
  processoId           String
  processo             Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)
  dataDisponibilizacao String
  tipoComunicacao      String
  nomeOrgao            String
  texto                String
  linkOriginal         String?
  tipoAtoDetectado     String
  faseProcessual       String   @default("ANDAMENTO")
  prazoDetectado       String?
  prazoFatal           String?
  audienciaDetectada   String?
  valorDetectado       String?
  urgencia             String
  statusConcorrencia   String
  criadoEm             DateTime @default(now())
}

model DocumentoOriginal {
  id                 String    @id @default(cuid())
  processoId         String?
  processo           Processo? @relation(fields: [processoId], references: [id], onDelete: SetNull)
  urlOriginal        String    @unique
  sistema            String    // PJE | EPROC | OUTRO
  statusExtracao     String    // SUCESSO | CAPTCHA_NECESSARIO | INDISPONIVEL | ERRO
  tituloDocumento    String?
  resultadoValidacao String?
  assinadoPor        String?
  dataHoraAssinatura String?
  totalPaginas       Int?
  tamanhoPdfBytes    Int?
  textoExtraido      String?
  criadoEm           DateTime  @default(now())
  atualizadoEm       DateTime  @updatedAt
}

model ExecucaoRadar {
  id                     String    @id @default(cuid())
  organizacaoId          String?   // Issue #79: Isolamento Multi-Tenant
  origem                 String    @default("MANUAL") // MANUAL | CRON
  clientesVarredura      Int       @default(0)
  oabsVarredura          Int       @default(0)
  publicacoesEncontradas Int       @default(0)
  processosSalvos        Int       @default(0)
  alertasAlta            Int       @default(0)
  status                 String    @default("SUCESSO") // SUCESSO | PARCIAL | ERRO
  detalhesJson           String?
  iniciadoEm             DateTime  @default(now())
  finalizadoEm           DateTime?

  @@index([organizacaoId])
}

model WebhookAlerta {
  id            String   @id @default(cuid())
  organizacaoId String?  // Issue #79: Isolamento Multi-Tenant
  nome          String
  canal         String   @default("WEBHOOK") // WEBHOOK | WHATSAPP | PUSH | SLACK | EMAIL
  urlDestino    String
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now())

  @@index([organizacaoId])
}

model LogEntregaWebhook {
  id          String   @id @default(cuid())
  webhookId   String?
  eventId     String?  // Issue #83: Idempotência X-Radar-Event-Id
  canal       String
  urlDestino  String
  evento      String
  payloadJson String?  // Issue #83: Payload salvo para Replay de falhas
  sucesso     Boolean
  httpStatus  Int?
  tentativas  Int      @default(1)
  erro        String?
  criadoEm    DateTime @default(now())
}

model CacheDatajud {
  id               String   @id @default(cuid())
  numeroProcesso   String   @unique
  indiceConsultado String
  dadosJson        String
  expiraEm         DateTime
  atualizadoEm     DateTime @updatedAt
}

model LogSaudeTribunal {
  id           String   @id @default(cuid())
  servico      String
  sistema      String
  status       String   // ONLINE | INSTAVEL | INDISPONIVEL
  httpStatus   Int
  latenciaMs   Int
  verificadoEm DateTime @default(now())
}

model LinkCompartilhamento {
  id             String   @id @default(cuid())
  organizacaoId  String?  // Issue #79: Isolamento Multi-Tenant
  token          String   @unique
  tipo           String   // CORRESPONDENTE_48H | PORTAL_CLIENTE
  escopo         String   // Número CNJ (20 dígitos) ou Nome do Cliente
  anonimizarLgpd Boolean  @default(false)
  expiraEm       DateTime
  criadoEm       DateTime @default(now())

  @@index([organizacaoId])
}

model Organizacao {
  id           String    @id @default(cuid())
  nome         String
  slug         String    @unique
  cnpj         String?
  plano        String    @default("FREE") // FREE | PRO | ENTERPRISE
  ativa        Boolean   @default(true)
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  usuarios     Usuario[]
}

model Usuario {
  id            String       @id @default(cuid())
  nome          String
  email         String       @unique
  senhaHash     String
  perfil        String       @default("ADVOGADO") // ADMIN | SOCIO | CONTROLADORIA | ADVOGADO | ESTAGIARIO
  ativo         Boolean      @default(true)
  organizacaoId String?
  organizacao   Organizacao? @relation(fields: [organizacaoId], references: [id], onDelete: SetNull)
  ultimoLoginEm DateTime?
  criadoEm      DateTime     @default(now())
  atualizadoEm  DateTime     @updatedAt
}

model CacheAnaliseIA {
  id           String   @id @default(cuid())
  hashConteudo String   @unique // Issue #77: SHA-256 do tipo + contexto limpo
  tipo         String   // ANALISE_PUBLICACAO | PRE_MINUTA | RAG_CHAT
  provedorIA   String
  modeloIA     String?
  respostaJson String
  hits         Int      @default(1)
  expiraEm     DateTime
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model PerfilColetivoVara {
  id                String   @id @default(cuid())
  chaveUnica        String   @unique // Issue #78: tribunal|orgaoJulgador|magistrado (100% anonimizado)
  siglaTribunal     String
  orgaoJulgador     String
  magistrado        String?
  totalAnalises     Int      @default(1)
  totalCriticos     Int      @default(0)
  totalBloqueios    Int      @default(0)
  totalLiminares    Int      @default(0)
  sumulasTemasJson  String?  // JSON array de súmulas/temas recorrentes nesta vara
  ultimaAtualizacao DateTime @updatedAt
  criadoEm          DateTime @updatedAt
}

model ModeloMinutaValidada {
  id                   String   @id @default(cuid())
  tipoMinuta           String   // RESPOSTA_AUTOMATICA | IMPUGNACAO_SISBAJUD | NULIDADE_ART_272_CPC | HABILITACAO_URGENTE
  siglaTribunal        String
  tituloPeca           String
  estruturaAnonimizada String   // Issue #78: Estrutura jurídica 100% anonimizada (sem nomes/CPFs)
  aprovacoes           Int      @default(1)
  criadoEm             DateTime @default(now())
  atualizadoEm         DateTime @updatedAt

  @@index([tipoMinuta, siglaTribunal])
}

model ApiKeyCliente {
  id            String    @id @default(cuid())
  organizacaoId String?   // Issue #79 + #80: Chave B2B vinculada à Organização
  nome          String
  prefixo       String    // Ex: rk_live_ab12cd34 (para exibição segura)
  chaveHash     String    @unique // SHA-256 da chave bruta
  plano         String    @default("FREE") // FREE | PRO | ENTERPRISE
  limiteMensal  Int       @default(1000)
  usoMesAtual   Int       @default(0)
  mesReferencia String    // YYYY-MM
  ativa         Boolean   @default(true)
  ultimoUsoEm   DateTime?
  criadoEm      DateTime  @default(now())

  @@index([organizacaoId])
}

model JobLoteConsulta {
  id             String    @id @default(cuid())
  organizacaoId  String?   // Issue #87: Processamento em Lote / Batch B2B
  tipo           String    @default("PROCESSOS") // PROCESSOS | CNPJS
  status         String    @default("EM_ANDAMENTO") // EM_ANDAMENTO | CONCLUIDO | ERRO
  totalItens     Int       @default(0)
  processados    Int       @default(0)
  sucessos       Int       @default(0)
  falhas         Int       @default(0)
  callbackUrl    String?
  entradasJson   String
  resultadosJson String?
  iniciadoEm     DateTime  @default(now())
  finalizadoEm   DateTime?

  @@index([organizacaoId])
}

model RegraAutomacao {
  id               String    @id @default(cuid())
  organizacaoId    String?   // Issue #90: Motor de Regras No-Code por Cliente
  nome             String
  ativa            Boolean   @default(true)
  condTribunal     String?   // Ex: "TRT4"
  condValorMinRS   Float?    // Ex: 50000
  condTipoAto      String?   // Ex: "SENTENCA"
  condUrgencia     String?   // Ex: "ALTA"
  condConcorrencia String?   // Ex: "SEM_ADVOGADO_CADASTRADO"
  acaoWebhookUrl   String?
  acaoGerarMinuta  Boolean   @default(false)
  acaoPrioridade   String    @default("CRITICA")
  totalDisparos    Int       @default(0)
  ultimoDisparoEm  DateTime?
  criadoEm         DateTime  @default(now())
  atualizadoEm     DateTime  @updatedAt

  @@index([organizacaoId])
}
