# ==============================================================================
# RADAR JURÍDICO — Variáveis de Ambiente (.env.example)
# Copie este arquivo para `.env` e preencha conforme o ambiente (Local ou Nuvem)
# ==============================================================================

# 1. Banco de Dados (Prisma ORM)
# Local (SQLite):
DATABASE_URL="file:./dev.db"
# Produção (PostgreSQL — Neon / Supabase / Railway):
# DATABASE_URL="postgresql://usuario:senha@host:5432/radar_juridico?sslmode=require"

# 2. API Pública do Datajud (CNJ) — opcional (já possui chave pública oficial em fallback)
# DATAJUD_API_KEY="cDZHYzlZa0JadVREZDJCendQbXY6SkJlTzNjLV9TRENyQk1RdnFKZGRQdw=="

# 3. POOL MULTI-IA GRATUITO (Rodízio + Failover Automático em HTTP 429)
# Você pode preencher quantos provedores gratuitos quiser — e até várias chaves
# separadas por vírgula (ex: GEMINI_API_KEY="chave1,chave2").
# Quando um modelo/provedor atinge o limite, entra em cooldown e o sistema pula
# automaticamente para o próximo da fila sem interromper o uso.

# Estratégia do ciclo:
# - FAILOVER_CICLICO (padrão): usa o atual até bater o limite (429), então passa para o próximo em ciclo
# - ROUND_ROBIN: alterna para a próxima IA a cada requisição
# IA_MODO_CICLO="FAILOVER_CICLICO"
# IA_ORDEM_PROVEDORES="GEMINI,GROQ,CEREBRAS,OPENROUTER,MISTRAL,NVIDIA,HUGGINGFACE,CLOUDFLARE,COHERE,OLLAMA,OPENAI"

# 3.1 Google AI Studio / Gemini (Grátis, sem cartão — também faz OCR de PDF escaneado)
# Onde pegar: https://aistudio.google.com/apikey
# GEMINI_API_KEY="AIza..."
# GEMINI_MODELS="gemini-2.5-flash,gemini-2.5-flash-lite"

# 3.2 Groq (Grátis, sem cartão — inferência ultra-rápida)
# Onde pegar: https://console.groq.com/keys
# GROQ_API_KEY="gsk_..."
# GROQ_MODELS="llama-3.3-70b-versatile,llama-3.1-8b-instant"

# 3.3 Cerebras (Grátis — até 1M tokens/dia em altíssima velocidade)
# Onde pegar: https://cloud.cerebras.ai/
# CEREBRAS_API_KEY="csk-..."
# CEREBRAS_MODELS="llama-3.3-70b,llama3.1-8b"

# 3.4 OpenRouter (Grátis, sem cartão — vários modelos :free em uma única chave)
# Onde pegar: https://openrouter.ai/keys
# OPENROUTER_API_KEY="sk-or-v1-..."
# OPENROUTER_MODELS="meta-llama/llama-3.3-70b-instruct:free,google/gemma-3-27b-it:free,mistralai/mistral-small-3.1-24b-instruct:free,deepseek/deepseek-r1-0528:free"

# 3.5 Mistral AI / La Plateforme (Free / Experiment Tier, sem cartão)
# Onde pegar: https://console.mistral.ai/api-keys/
# MISTRAL_API_KEY="..."
# MISTRAL_MODELS="mistral-small-latest,open-mistral-nemo"

# 3.6 NVIDIA NIM / Build (Grátis para prototipagem e testes)
# Onde pegar: https://build.nvidia.com/
# NVIDIA_API_KEY="nvapi-..."
# NVIDIA_MODELS="meta/llama-3.3-70b-instruct,mistralai/mistral-small-24b-instruct"

# 3.7 Hugging Face Inference Providers (Free Tier, sem cartão)
# Onde pegar: https://huggingface.co/settings/tokens
# HUGGINGFACE_API_KEY="hf_..."
# HUGGINGFACE_MODELS="meta-llama/Llama-3.3-70B-Instruct,Qwen/Qwen2.5-72B-Instruct"

# 3.8 Cloudflare Workers AI (Grátis — 10.000 Neurons/dia)
# Onde pegar: https://dash.cloudflare.com/ -> AI -> Workers AI
# CLOUDFLARE_ACCOUNT_ID="seu-account-id"
# CLOUDFLARE_API_TOKEN="seu-token"
# CLOUDFLARE_MODELS="@cf/meta/llama-3.3-70b-instruct-fp8-fast,@cf/meta/llama-3.1-8b-instruct"

# 3.9 Cohere Trial (Grátis — ~1.000 chamadas/mês para testes)
# Onde pegar: https://dashboard.cohere.com/api-keys
# COHERE_API_KEY="..."
# COHERE_MODELS="command-a-03-2025,command-r-08-2024"

# 3.10 Ollama Local (100% offline no seu PC, sem limite de requisições)
# Onde pegar: https://ollama.com/
# OLLAMA_BASE_URL="http://localhost:11434"
# OLLAMA_MODELS="llama3.2,qwen2.5:7b"

# 3.11 OpenAI (Opcional / pago)
# OPENAI_API_KEY="sk-..."
# OPENAI_MODELS="gpt-4o-mini"

# 4. Segurança, Autenticação API (JWT) & Cron (OBRIGATÓRIOS em produção)
# JWT_SECRET="gere-um-segredo-aleatorio-de-pelo-menos-32-caracteres"
# CRON_SECRET="segredo-usado-pelo-vercel-cron-ou-agendador"
# WEBHOOK_HMAC_SECRET="segredo-para-assinatura-hmac-sha256-dos-webhooks"
# API_ACCESS_KEY="chave-mestra-para-emitir-tokens-jwt-via-api-auth-token"
# ENFORCE_AUTH="false" # Defina "true" em produção para exigir Bearer JWT nas rotas /api/*

# 5. Integrações Opcionais de Notificação
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"
# EMAIL_FROM="Radar Jurídico <alertas@seudominio.com.br>"
# EMAIL_DESTINO_ALERTAS="controladoria@escritorio.com.br"
