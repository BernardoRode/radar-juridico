# ==============================================================================
# RADAR JURÍDICO — Variáveis de Ambiente (.env.example)
# Copie este arquivo para `.env` e preencha conforme o ambiente (Local ou Nuvem)
# ==============================================================================

# 1. Banco de Dados (Prisma ORM)
# Local (SQLite):
DATABASE_URL="file:./dev.db"
# Produção (PostgreSQL — Neon / Supabase / Railway):
# DATABASE_URL="postgresql://usuario:senha@host:5432/radar_juridico?sslmode=require"

# 2. API Pública do Datajud (CNJ) — opcional (já possui chave pública oficial em fallback)
# DATAJUD_API_KEY="cDZHYzlZa0JadVREZDJCendQbXY6SkJlTzNjLV9TRENyQk1RdnFKZGRQdw=="

# 3. Inteligência Artificial (LLM) — opcional (sem chave, usa fallback heurístico/template)
# GEMINI_API_KEY="sua-chave-google-ai-studio"
# OPENAI_API_KEY="sua-chave-openai"

# 4. Segurança, Autenticação API (JWT) & Cron (OBRIGATÓRIOS em produção)
# JWT_SECRET="gere-um-segredo-aleatorio-de-pelo-menos-32-caracteres"
# CRON_SECRET="segredo-usado-pelo-vercel-cron-ou-agendador"
# WEBHOOK_HMAC_SECRET="segredo-para-assinatura-hmac-sha256-dos-webhooks"
# API_ACCESS_KEY="chave-mestra-para-emitir-tokens-jwt-via-api-auth-token"
# ENFORCE_AUTH="false" # Defina "true" em produção para exigir Bearer JWT nas rotas /api/*

# 5. Integrações Opcionais de Notificação
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"
# EMAIL_FROM="Radar Jurídico <alertas@seudominio.com.br>"
# EMAIL_DESTINO_ALERTAS="controladoria@escritorio.com.br"
